{
  "name": "pandamonium",
  "version": "1.0.0",
  "description": "Blockly visual programming UI for Data Science with Pandas and Scikit-Learn",
  "type": "module",
  "main": "./dist/pandamonium.umd.js",
  "module": "./dist/pandamonium.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pandamonium.es.js",
      "require": "./dist/pandamonium.umd.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aneesha/pandamonium.git"
  },
  "keywords": [
    "blockly",
    "pandas",
    "scikit-learn",
    "data-science",
    "visual-programming",
    "python"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aneesha/pandamonium/issues"
  },
  "homepage": "https://github.com/aneesha/pandamonium#readme",
  "dependencies": {
    "blockly": "^12.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
